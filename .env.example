# ─────────────────────────────────────────────────────────────
# JMarket – ตัวแปรสภาพแวดล้อม
# คัดลอกไฟล์นี้เป็น .env.local (ตอน dev) และตั้งค่าเดียวกันบน Vercel (ตอน deploy)
# ─────────────────────────────────────────────────────────────

# Postgres จาก Supabase — ใช้ "Connection pooling" string (พอร์ต 6543, ต่อท้าย ?pgbouncer=true)
# Supabase Dashboard → Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Postgres แบบต่อตรง (พอร์ต 5432) — ใช้เฉพาะตอนรัน migration ในเครื่อง (drizzle-kit)
# Supabase Dashboard → Project Settings → Database → Connection string → "Direct connection"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xxx.pooler.supabase.com:5432/postgres"

# Supabase Storage — สำหรับอัปโหลดรูปจากฝั่งเซิร์ฟเวอร์
# Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."          # ⚠️ ห้ามเผยแพร่ / ห้ามขึ้น client
SUPABASE_STORAGE_BUCKET="restaurant-images"                # ชื่อ bucket (public) ที่สร้างไว้ใน Supabase

# Auth ของหน้า admin
# สร้าง hash ด้วย:  npm run hash -- 'รหัสผ่านที่ต้องการ'
ADMIN_PASSWORD_HASH="scrypt:xxxxxxxx:xxxxxxxx"
# คีย์ลับสำหรับเซ็น session cookie — สุ่มยาว ๆ เช่น:  openssl rand -base64 48
AUTH_SECRET="เปลี่ยนเป็นค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร"

# URL ของเว็บ (ใช้ทำ og:image / ลิงก์ absolute) — ตอน deploy ใส่ค่าจริงจาก Vercel
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
